# ========================================
# BillTable Backend - Environment Variables
# ========================================

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billtable
DB_USER=kazz
DB_PASSWORD=

# Security
JWT_SECRET=billtable-jwt-secret-change-in-production-2026
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=billtable-refresh-secret-change-in-production-2026
REFRESH_TOKEN_EXPIRE=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

# API Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100